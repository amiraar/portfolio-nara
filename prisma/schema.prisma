// prisma/schema.prisma — Database schema for Project Nara
// Run `npx prisma db push` to sync with Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Visitor {
  id            String         @id @default(cuid())
  name          String
  /// Unverified, self-reported contact address. Not an identity key: several
  /// Visitor rows may share one email (identity is the cookie token only).
  email         String
  /// SHA-256 hex of the server-issued token. The raw token lives only in the
  /// visitor's HttpOnly cookie, so a database leak does not yield usable tokens.
  token         String?        @unique
  /// Server-side expiry of `token` (mirrors the cookie Max-Age).
  tokenExpiresAt DateTime?
  /// When the visitor last gave explicit consent to data processing (UU PDP evidence)
  consentAt     DateTime?
  createdAt     DateTime       @default(now())
  conversations Conversation[]

  @@index([email])
}

model Conversation {
  id        String    @id @default(cuid())
  visitorId String
  visitor   Visitor   @relation(fields: [visitorId], references: [id])
  /// active | resolved
  status    String    @default("active")
  /// ai | human
  mode      String    @default("ai")
  /// Timestamp of the last time the owner viewed this conversation.
  /// Used to compute the unread message count for the dashboard.
  ownerLastReadAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  /// user | assistant | owner
  role           String
  content        String
  timestamp      DateTime     @default(now())
}

model PortfolioContent {
  id        String   @id @default(cuid())
  /// "hero" | "experience" | "projects" | "skills" | "education"
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

/// Single-row state for the owner login (id is always "owner").
model OwnerAuthState {
  id            String    @id @default("owner")
  /// Sessions whose loginAt is at or before this instant are rejected
  /// (set on sign-out — NextAuth JWT sessions cannot otherwise be revoked).
  revokedBefore DateTime?
  /// Last accepted TOTP time step; a code for this step or earlier is a replay.
  lastTotpStep  Int?
}

/// Durable audit trail: owner actions and authentication events.
/// Never store message bodies or visitor PII in `details`. Rows older than
/// 90 days are deleted by /api/cron/retention (`ip` is personal data).
model AuditEvent {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  /// Owner email for owner actions, "anonymous" for unauthenticated attempts
  actor   String
  /// e.g. "auth.login_failed", "portfolio.update"
  action  String
  ip      String?
  details Json?

  @@index([at])
  @@index([action, at])
}

/// Server error log, shown in the dashboard Logs view (lib/logger.js).
/// Never store message bodies or visitor PII. Rows older than 90 days are
/// deleted by /api/cron/retention.
model AppLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  /// Where the error happened, e.g. "POST /api/chat", "kaia"
  source  String
  message String
  details Json?

  @@index([at])
}

/// Persistent rate-limit counters — replaces the unreliable in-memory store.
/// key = "<scope>:<identifier>:<maxRequests>:<windowSec>"
/// Atomic upsert via raw SQL ensures correctness across serverless instances.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rate_limit_entries")
}
